# Polymarket CLOB credentials
# Your Ethereum private key (hex, no 0x prefix)
PK=your_private_key_here

# Polymarket API key credentials (obtain via client.create_or_derive_api_creds())
CLOB_API_KEY=your_api_key
CLOB_SECRET=your_api_secret
CLOB_PASS_PHRASE=your_passphrase

# Optional: set to "true" to run against a testnet / paper-trade
PAPER_TRADE=false

# Funder address if using proxy wallet pattern (leave blank to use PK address)
FUNDER_ADDRESS=
