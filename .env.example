# =============================================================================
# Polymarket Trading Bot — Credentials
# =============================================================================
#
# QUICK START
# -----------
# 1. cp .env.example .env
# 2. Set PK to your Polymarket wallet's private key (see "How to get PK" below)
# 3. python setup_auth.py          ← derives + writes CLOB_API_KEY/SECRET/PASS
# 4. python bot.py --paper         ← paper trade (no real bets placed)
# 5. python bot.py                 ← live trading
#
# HOW TO GET YOUR PRIVATE KEY
# ----------------------------
# Polymarket uses a standard EVM (Polygon) wallet:
#
#   MetaMask:           Account menu → Account Details → Export private key
#   Coinbase Wallet:    Settings → Security → Export private key
#   Polymarket magic:   polymarket.com → Profile → Settings → Export wallet
#   Privy/embedded:     use the Privy dashboard to export
#
# ⚠  Never share your private key or commit this file to git.
#    Add .env to your .gitignore (it already is in this repo).
#
# =============================================================================

# Your Ethereum/Polygon wallet private key (hex, with or without 0x prefix).
# This is the master key; guard it carefully.
PK=your_private_key_here

# CLOB API credentials — derived from PK by running: python setup_auth.py
# Leave blank on first run; setup_auth.py will populate these automatically.
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASS_PHRASE=

# Trading mode
# ------------
# true  → paper trade: auth is real, market data is real, NO orders are placed
# false → live trade:  real orders placed, real USDC at risk
PAPER_TRADE=true

# Virtual wallet size used in paper trade mode (doesn't need real USDC)
PAPER_BALANCE_USDC=1000

# Proxy / Safe wallet (advanced)
# If you use a Polymarket Safe proxy wallet, set this to the funder (Safe) address.
# Leave blank to use the address derived from PK directly.
FUNDER_ADDRESS=

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Copy-watch trader tracker (optional)
# ---------------------------------------------------------------------------
# Polymarket wallet address to shadow in real time.
# The tracker polls the Data API every TRACKER_POLL_SECS seconds and logs
# every new trade it sees.  Leave blank to disable.
TRACK_ADDRESS=

# Polling interval in seconds (default 2).  Lower = faster copy-trade detection.
# 2 s gives ~2–4 s lag on top of the CLOB API's own indexing delay.
TRACKER_POLL_SECS=2

# Set to true to enable copy-trading (required alongside TRACKER_COPY_MODE).
TRACKER_COPY_TRADE=false

# Copy-trade mode (only used when TRACKER_COPY_TRADE=true):
#   blind  → mirror every BUY with no gates; order size is proportional to
#            how much of their wallet the target used vs yours.
#   gated  → route through fair-value, TA, and risk gates before placing.
# Can also be overridden at startup: --copy-blind / --copy-gated
# Or toggled live from the console: copy-blind / copy-gated / copy-off
TRACKER_COPY_MODE=gated

# Fallback order size (USDC) for blind copy when the target's wallet
# value cannot be fetched and proportional sizing is unavailable.
COPY_BLIND_USDC=10
